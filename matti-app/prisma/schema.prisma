generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  password         String?
  role             String   @default("consumer")
  plan             String   @default("free")
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  receipts      Receipt[]      @relation("ConsumerReceipts")
  store         Store?
  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  stripeSubscriptionId String?   @unique
  stripeSessionId      String?
  plan                 String
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
}

model Settings {
  key       String @id
  value     String
}

model Store {
  id      String  @id @default(cuid())
  name    String
  address String
  logo    String?
  taxId   String?
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id])

  receipts Receipt[]
  apiKeys  ApiKey[]
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique @default(cuid())
  name      String    @default("Standard-Schlüssel")
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
}

model Receipt {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  consumerId String?
  consumer   User?     @relation("ConsumerReceipts", fields: [consumerId], references: [id])
  total      Float
  tax        Float
  subtotal   Float
  category   String    @default("Sonstiges")
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  claimedAt  DateTime?

  items ReceiptItem[]
}

model ReceiptItem {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id])
  name      String
  quantity  Float
  price     Float
  total     Float
}
